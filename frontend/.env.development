# Chạy `npm start` trong frontend: API sẽ gọi qua proxy tới backend cổng 5000 (xem package.json "proxy").
# Chỉ bỏ comment dòng dưới nếu bạn muốn gọi thẳng backend (và đảm bảo backend + CORS OK):
# REACT_APP_API_URL=http://127.0.0.1:5000/api

# Socket (realtime) vẫn cần URL tuyệt đối tới backend:
REACT_APP_SOCKET_URL=http://127.0.0.1:5000
