PORT=5000
MONGODB_URI=mongodb://localhost:27017/dormitory_db
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# VNPay (sandbox-ready)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Backend nhận redirect từ VNPay (verify chữ ký tại server)
VNP_RETURN_URL=http://localhost:5000/api/payment/vnpay-return
# Sau khi xử lý — chuyển trình duyệt về SPA (sinh viên)
VNP_FRONTEND_REDIRECT_URL=http://localhost:3000/student/my-bills
# Ghép returnPath tùy chọn (/admin/bills) — ví dụ http://localhost:3000
VNP_FRONTEND_ORIGIN=http://localhost:3000
# Đăng ký URL IPN trên portal VNPay (sandbox)
VNP_IPN_URL=http://localhost:5000/api/payment/vnpay-ipn
